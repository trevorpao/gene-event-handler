{
  "name": "gene-event-handler",
  "version": "2.1.0",
  "description": "a event handler",
  "author": "Trevor Pao",
  "scripts": {
    "watch": "parcel serve app/index.html --open",
    "readme": "http-server document -p 3000 -c-1 -o index.html",
    "build": "esbuild src/base.js --bundle --minify --format=iife --global-name=gee --outfile=dist/gene.min.js",
    "lint": "npx eslint ./src/*.js",
    "fix": "npx eslint ./src/*.js --fix"
  },
  "source": "src/index.js",
  "main": "dist/gene.min.js",
  "module": "src/base.js",
  "exports": {
    ".": {
      "import": "./src/base.js",
      "require": "./dist/gene.min.js",
      "default": "./src/base.js"
    }
  },
  "license": "MIT",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "repository": {
    "type": "git",
    "url": "git@github.com:trevorpao/geneEH.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "http-server": "^14.1.1",
    "parcel": "^2.16.3"
  },
  "eslintConfig": {
    "env": {
      "es6": true,
      "node": true,
      "browser": true
    },
    "rules": {
      "quotes": [
        2,
        "single"
      ]
    }
  },
  "files": [
    "src",
    "dist/gene.min.js"
  ],
  "dependencies": {}
}
