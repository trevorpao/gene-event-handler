{
  "name": "gene-event-handler",
  "version": "0.2",
  "description": "a event handler",
  "author": "Trevor Pao",
  "scripts": {
    "watch": "parcel serve app/index.html --open",
    "readme": "http-server document -p 3000 -c-1 -o index.html",
    "build": "parcel build",
    "lint": "npx eslint ./src/*.js",
    "fix": "npx eslint ./src/*.js --fix"
  },
  "source": "src/index.js",
  "license": "MIT",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "repository": {
    "type": "git",
    "url": "git@github.com:trevorpao/geneEH.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "parcel": "^2.16.3"
  },
  "eslintConfig": {
    "env": {
      "es6": true,
      "node": true,
      "browser": true,
      "jquery": true
    },
    "rules": {
      "quotes": [
        2,
        "single"
      ]
    }
  },
  "dependencies": {
    "cash-dom": "^8.1.5"
  }
}
